# Copie ce fichier en .env et adapte les valeurs.
# Les variables EXPO_PUBLIC_* sont injectées dans le bundle par Expo :
# n'y mets jamais de secret, elles sont lisibles dans l'app publiée.

# Port de l'API. Doit correspondre au PORT du .env du serveur (api/.env).
# En développement, l'adresse IP est déduite automatiquement du serveur Metro.
EXPO_PUBLIC_API_PORT=3001

# URL complète du serveur. Obligatoire pour une build de production :
# hors développement, il n'y a pas de serveur Metro d'où déduire l'adresse.
# EXPO_PUBLIC_API_URL=https://api.exemple.ci
